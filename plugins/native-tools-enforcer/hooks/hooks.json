{
  "description": "SessionStart hook injects native-tool usage directives. PreToolUse hook blocks Bash CLI tools in favor of Claude Code native tools (or bfs/ugrep on native builds).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-native-tools.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
