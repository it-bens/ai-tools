{
  "description": "PreToolUse hook to block native clipboard-write Bash commands and route them to the clipboard-copy MCP tools.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-clipboard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
