{
  "description": "PreToolUse hook to block Plan subagent unless using Sonnet or Opus model",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/enforce-sonnet-plan.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
