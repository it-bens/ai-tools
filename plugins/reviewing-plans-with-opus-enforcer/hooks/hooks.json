{
  "description": "PreToolUse hook to block reviewing-plans skill invocations on non-Opus sessions",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/enforce-opus-skill.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
